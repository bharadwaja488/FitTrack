# Local development template only. Configure production credentials independently
# in the deployment environment; never copy production secrets into this file.
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
# Disposable local development schema only. Never use production credentials here.
DB_NAME=fittrack_dev_local
SECRET_KEY=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
FRONTEND_URL=http://localhost:5174
FRONTEND_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
MAIL_SERVER=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PORT=587
MAIL_USE_TLS=true
COOKIE_SECURE=false
FLASK_DEBUG=false
RATELIMIT_STORAGE_URI=memory://
PORT=5000
DB_SSL_CA=
DB_SSL_VERIFY_CERT=false
DB_SSL_VERIFY_IDENTITY=false
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=20
DB_WRITE_TIMEOUT=20
TRUSTED_PROXY_HOPS=0
